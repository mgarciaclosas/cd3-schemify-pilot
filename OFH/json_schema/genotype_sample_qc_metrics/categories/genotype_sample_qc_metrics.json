        {
          "type": "number",
          "not": {
            "enum": [
              -998
            ]
          }
        },
        {
          "$ref": "../../common/defs.json#/$defs/not_recorded"
        }
      ],
      "x-unit": "proportion of variants with genotype call",
      "$comment": "The source states no range, so none is asserted (D024)."
    },
