  "properties": {
    "PID": {
      "title": "Participant ID",
      "type": "string",
      "x-role": "entity key",
      "$comment": "Many-to-one link to participant.PID; that every PID exists there cannot be enforced across tables (D102). The source states no format, so no pattern is asserted (D043)."
    },
    "plate": {
      "title": "Plate",
      "description": "Identifier of the microwell plate of the sample",
      "anyOf": [
        {
          "type": "string",
          "not": {
            "const": "-998"
          }
        },
        {
          "$ref": "../../common/defs.json#/$defs/not_recorded_text"
        }
      ]
    },
    "genetic_sex": {
      "title": "Genetic sex",
      "description": "Estimated genetic sex of the sample",
      "oneOf": [
        {
          "const": "M",
          "title": "Male"
        },
        {
          "const": "F",
          "title": "Female"
        },
        {
          "const": "U",
          "title": "Unknown"
        },
        {
          "$ref": "../../common/defs.json#/$defs/not_recorded_text"
        }
      ]
    },
    "batch": {
      "title": "Batch",
      "description": "Identifier of the batch based on the date of genotype calling and the microwell plate identifier",
      "anyOf": [
        {
          "type": "string",
          "not": {
            "const": "-998"
          }
        },
        {
          "$ref": "../../common/defs.json#/$defs/not_recorded_text"
        }
      ]
    },
